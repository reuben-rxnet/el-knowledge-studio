{
  "name": "el-knowledge-studio",
  "version": "0.1.0",
  "private": true,
  "description": "EL Knowledge Studio — Capture once. Share knowledge everywhere.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:push": "prisma db push --skip-generate",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset --skip-generate && tsx prisma/seed.ts",
    "setup": "prisma generate && prisma db push --skip-generate && tsx prisma/seed.ts",
    "eval": "tsx --conditions=react-server --env-file=.env scripts/eval.ts",
    "iam:manifest": "tsx --env-file=.env scripts/iam-manifest.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.14.0",
    "@azure/storage-blob": "^12.34.0",
    "@huggingface/transformers": "^4.3.1",
    "@prisma/client": "^6.19.0",
    "clsx": "^2.1.1",
    "ffmpeg-static": "^5.3.0",
    "jszip": "^3.10.2",
    "kokoro-js": "^1.2.1",
    "lucide-react": "^0.544.0",
    "next": "^16.0.0",
    "openid-client": "^6.8.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "unpdf": "^1.9.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.0.0",
    "jsdom": "^27.0.0",
    "oidc-provider": "^9.13.0",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "ffmpeg-static@5.3.0": true,
    "onnxruntime-node@1.21.0": true,
    "onnxruntime-node@1.30.0": true,
    "protobufjs@7.6.6": true,
    "sharp@0.34.5": true,
    "sharp@0.35.4": true
  }
}
