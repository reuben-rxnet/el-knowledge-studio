# ------------------------------------------------------------------
# EL Knowledge Studio — environment configuration
# Copy to .env for local development. NEVER commit real values.
# Production secrets belong in Azure Key Vault.
# ------------------------------------------------------------------

# Local prototype uses SQLite. Production target: PostgreSQL (see docs/deployment.md).
DATABASE_URL="file:./dev.db"

# "demo" enables the local persona switcher. It is refused when NODE_ENV=production.
AUTH_PROVIDER=demo
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=

# ---------------- AI provider ----------------
# mock   = deterministic, offline (default). No external calls.
# openai = OpenAI Codex, same setup as Knowzy (EssilorLuxottica APIM gateway).
AI_PROVIDER=mock

# Codex through the EssilorLuxottica Azure API Management gateway (as configured in Knowzy):
OPENAI_BASE_URL=https://dev-apim-ai.luxottica.com/codex/openai/v1
OPENAI_MODEL=gpt-5.3-codex_codeassist
OPENAI_API_STYLE=RESPONSES
OPENAI_AUTH_LOCATION=QUERY_PARAMETER
OPENAI_AUTH_QUERY_PARAMETER=subscription-key
OPENAI_AUTH_HEADER_NAME=authorization
# Non-secret fixed headers, "name: value; name2: value2" (max 5). Credential-shaped names are refused.
OPENAI_EXTRA_HEADERS="x-openai-supplier: EssilorLuxottica"
# The gateway subscription key. Local .env only — never commit. Production: Key Vault.
OPENAI_API_KEY=
# Hosts the key may be sent to, besides api.openai.com. Deployment configuration, never a screen.
LLM_ENDPOINT_ALLOWLIST=dev-apim-ai.luxottica.com
# External AI is blocked until a data-processing approval is recorded (e.g. a Privacy ticket ID).
AI_DATA_PROCESSING_APPROVAL_REF=
OPENAI_TIMEOUT_MS=120000
# Speech-to-text for recordings. Codex models do not transcribe audio: leave empty unless your
# endpoint exposes a transcription deployment (e.g. whisper-1 or gpt-4o-transcribe).
OPENAI_TRANSCRIBE_MODEL=
# Optional separate endpoint for transcription (must also be in LLM_ENDPOINT_ALLOWLIST).
OPENAI_TRANSCRIBE_BASE_URL=
OPENAI_MAX_OUTPUT_TOKENS=

# ---------------- Open-source media (runs on this server) ----------------
# local = Whisper (speech-to-text) and Kokoro (AI voice, English) run here; nothing leaves the server.
# Models download once from Hugging Face into MODELS_DIR. off = no transcription.
SPEECH_PROVIDER=local
LOCAL_STT_MODEL=onnx-community/whisper-base
MODELS_DIR=./models
# FFmpeg for rendering. Empty = the bundled ffmpeg-static build (GPL). Production: an IT-approved LGPL build.
FFMPEG_PATH=

# ---------------- Other Azure services (stubs) ----------------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
AZURE_SPEECH_REGION=
AZURE_SPEECH_KEY=
AZURE_TRANSLATOR_ENDPOINT=
AZURE_TRANSLATOR_KEY=
AZURE_AI_SEARCH_ENDPOINT=
AZURE_AI_SEARCH_INDEX=
AZURE_AI_SEARCH_KEY=
VIDEO_INDEXER_ACCOUNT_ID=
VIDEO_INDEXER_LOCATION=
VIDEO_INDEXER_SUBSCRIPTION_KEY=
APPLICATION_INSIGHTS_CONNECTION_STRING=

# Knowzy: approved guides are written here as Markdown (+ .meta.json sidecars) for a Knowzy
# FILE_REPOSITORY source to sync. Empty = the simulated Knowzy connector.
KNOWZY_EXPORT_DIR=

# Mock flags — no external calls are made while these are true.
MOCK_AI_SERVICES=true
MOCK_PUBLISHING_CONNECTORS=true

# Upload limit in megabytes.
MAX_UPLOAD_MB=2048
# ---------------- File storage (uploads, recordings, screenshots, videos) ----------------
# local = files under STORAGE_DIR. azure-blob = a private Blob container.
STORAGE_PROVIDER=local
STORAGE_DIR=./storage
# azure-blob in Azure: the app's managed identity (no keys). Set by infra/main.bicep.
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=media
# azure-blob locally: the Azurite emulator instead, e.g. UseDevelopmentStorage=true
AZURE_STORAGE_CONNECTION_STRING=
LOCAL_UPLOAD_MAX_MB=200
